<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- Microservice Name -->
  <property name="MICROSERVICE_NAME" value="cctns-autosave-producer-service" />

  <!-- Console Appender -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>
        %d{yyyy-MM-dd HH:mm:ss} [%X{microservice:-${MICROSERVICE_NAME}}] %logger{36} - %M - Line:%L - %msg%n
      </pattern>
    </encoder>
  </appender>

  <!-- Rolling File Appender -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>logs/cctns-common-search-service.log</file> <!-- Log file location -->
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>logs/cctns-common-search-service-%d{yyyy-MM-dd}.%d.log</fileNamePattern>
      <maxHistory>7</maxHistory>
      <maxFileSize>2MB</maxFileSize>
    </rollingPolicy>
    <encoder>
      <pattern>
        %d{yyyy-MM-dd HH:mm:ss} [%X{microservice:-${MICROSERVICE_NAME}}] %logger{36} - %M - Line:%L - %msg%n
      </pattern>
    </encoder>
  </appender>

  <!-- Root Logger -->
  <root level="info">
    <appender-ref ref="CONSOLE" />
    <appender-ref ref="FILE" />

  </root>
</configuration>
